# AimPro Backend Server Environment Configuration (Template)
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Replace with your Atlas connection string in production)
MONGODB_URI=mongodb://127.0.0.1:27017/aimpro

# JWT Authentication Secret Key
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend Client URL for CORS
CLIENT_ORIGIN=http://localhost:5173
